// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id BigInt @id @default(autoincrement())
  title String
  content String?
  createdAt DateTime @default(now())
}

model Book {
  id             String         @id @default(uuid())
  clerkId        String
  title          String
  slug           String         @unique
  author         String
  persona        String?
  fileURL        String
  fileBlobKey    String
  coverURL       String
  coverBlobKey   String?
  fileSize       BigInt
  totalSegments  Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  segments       BookSegment[]
  voiceSessions  VoiceSession[]

  @@map("books")
}

model BookSegment {
  id            String   @id @default(uuid())
  clerkId       String
  bookId        String
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  content       String
  segmentIndex  Int
  pageNumber    Int?
  wordCount     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("book_segments")
}

model VoiceSession {
  id                  String    @id @default(uuid())
  clerkId             String
  bookId              String
  book                Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  startedAt           DateTime
  endedAt             DateTime?
  durationSeconds     Int
  billingPeriodStart  DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("voice_sessions")
}